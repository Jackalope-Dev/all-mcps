{
  "name": "all-mcps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run cf-typegen",
    "prebuild": "node scripts/build-blog-manifest.mjs && node scripts/build-category-manifest.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:eslint": "eslint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && npm run deploy:cf",
    "deploy:cf": "node scripts/prune-isr-seed.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply all-mcps --local",
    "db:migrate:prod": "wrangler d1 migrations apply all-mcps --remote",
    "db:studio": "drizzle-kit studio",
    "submit-index": "node scripts/submit-indexnow.mjs",
    "ingest-sources": "node scripts/ingest-sources.mjs",
    "backfill-categories": "tsx scripts/backfill-categories.ts",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "sync-snapshot": "node scripts/sync-snapshot.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@cf-wasm/photon": "^0.4.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@react-email/components": "^1.0.12",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "^4.0.3",
    "jimp": "^1.6.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@opennextjs/cloudflare": "1.20.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "e2b": "^2.49.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "lefthook": "^2.1.14",
    "lightningcss": "^1.33.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "4.131.2"
  },
  "optionalDependencies": {
    "@biomejs/cli-win32-x64": "^2.5.13",
    "@rolldown/binding-win32-x64-msvc": "^1.2.9",
    "@typescript/typescript-win32-x64": "^7.0.2",
    "lefthook-windows-x64": "^2.1.14",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "comments": {
    "overrides": "Transitive security fixes with no direct dependency to bump. Each is scoped to the major line that is actually vulnerable — brace-expansion 1.x/2.x are unaffected (the advisory starts at 4.0.0) and forcing them to 5.x would change an API they rely on. Drop an entry once the parent package ships a fix that satisfies it on its own."
  },
  "overrides": {
    "brace-expansion@>=4.0.0": "^5.0.9",
    "fast-uri": "^3.1.6",
    "js-yaml@^3.0.0": "^3.15.2",
    "js-yaml@^4.0.0": "^4.3.2",
    "sharp": "^0.35.4"
  }
}
