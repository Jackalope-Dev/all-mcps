{
  "name": "all-mcps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run cf-typegen",
    "prebuild": "node scripts/build-blog-manifest.mjs && node scripts/build-category-manifest.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:eslint": "eslint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply all-mcps --local",
    "db:migrate:prod": "wrangler d1 migrations apply all-mcps --remote",
    "db:studio": "drizzle-kit studio",
    "submit-index": "node scripts/submit-indexnow.mjs",
    "ingest-sources": "node scripts/ingest-sources.mjs",
    "backfill-categories": "tsx scripts/backfill-categories.ts",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "sync-snapshot": "node scripts/sync-snapshot.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@cf-wasm/photon": "^0.3.7",
    "@marsidev/react-turnstile": "^1.5.4",
    "@react-email/components": "^1.0.12",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "^4.0.3",
    "jimp": "^0.22.12",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "potrace": "^2.1.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "e2b": "^2.38.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "lefthook": "^2.1.10",
    "lightningcss": "^1.33.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "optionalDependencies": {
    "@biomejs/cli-win32-x64": "^2.5.10",
    "@rolldown/binding-win32-x64-msvc": "^1.2.6",
    "@typescript/typescript-win32-x64": "^7.0.2",
    "lefthook-windows-x64": "^2.1.10",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
