{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "all-mcps",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "vars": {
    "RESEND_TO_EMAIL": "contact@allmcps.com",
    "RESEND_FROM_EMAIL": "contact@allmcps.com",
    // Site half of the Worker split: schedules every cron but sends all jobs
    // except isr-cache-cleanup to all-mcps-jobs over JOBS (custom-worker.ts).
    "WORKER_ROLE": "site"
  },
  "routes": [{ "pattern": "allmcps.com", "custom_domain": true }],
  "services": [
    {
      // Self-reference binding required by the R2/DO ISR revalidation queue
      // (see @opennextjs/cloudflare) — without it every ISR page fails with
      // "Failed to revalidate stale page" and just re-renders on every hit.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "all-mcps"
    },
    {
      // The background-jobs Worker (env.jobs below). Cron jobs and external
      // /api/cron/* requests run there, never in the isolate serving pages.
      "binding": "JOBS",
      "service": "all-mcps-jobs"
    }
  ],
  "triggers": {
    // The site is the only scheduler (lib/cronSchedule.ts jobsForTick):
    // "0 */4 * * *" isr-cache-cleanup (runs here) + the slow list,
    // "*/15 * * * *" health + enrich, "*/20 * * * *" ai-content as two
    // batch-24 runs. Everything but isr-cache-cleanup executes on
    // all-mcps-jobs. Keep these patterns stable: Cloudflare kept firing the
    // previous set for over an hour after a change here.
    "crons": ["0 */4 * * *", "*/15 * * * *", "*/20 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "all-mcps",
      "database_id": "c0e237c4-fa3c-45f0-8400-b2dd44615f94",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOGOS",
      "bucket_name": "all-mcps-logos"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "all-mcps-isr-cache"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "mcp-servers-index"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    // Dedicated background-jobs Worker: deploys as `all-mcps-jobs` from the
    // same build (scripts/deploy-jobs-worker.mjs, run by `deploy:cf` before
    // the site). It executes every job except isr-cache-cleanup (see
    // SITE_JOBS in lib/cronSchedule.ts) and serves only /api/cron/*, so LLM
    // batches and backfills never share an isolate with page traffic. No
    // routes or workers.dev URL: it's reached only through the site Worker's
    // JOBS service binding.
    //
    // Wrangler does not inherit bindings, vars or triggers into an env, so
    // everything below is repeated from the top level. KEEP IN SYNC with it
    // (and with wrangler.build.jsonc) when adding or renaming a binding.
    // Secrets come from the site over SITE_SECRETS (JOB_SECRET_NAMES in
    // lib/cronSchedule.ts); add a name there if a cron starts reading a new one.
    "jobs": {
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "RESEND_TO_EMAIL": "contact@allmcps.com",
        "RESEND_FROM_EMAIL": "contact@allmcps.com",
        "WORKER_ROLE": "jobs"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "all-mcps-jobs"
        },
        {
          // RPC to the site Worker's SecretRelay entrypoint (custom-worker.ts):
          // the jobs Worker gets its secrets from the site instead of a second
          // hand-entered copy. A secret set directly here still wins.
          "binding": "SITE_SECRETS",
          "service": "all-mcps",
          "entrypoint": "SecretRelay"
        }
      ],
      // No schedules of its own: the site schedules and sends each job here
      // over JOBS. (This Worker's own crons never fired, and a single
      // scheduler can't double-run a job.)
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "all-mcps",
          "database_id": "c0e237c4-fa3c-45f0-8400-b2dd44615f94",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "LOGOS",
          "bucket_name": "all-mcps-logos"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "all-mcps-isr-cache"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTOR_INDEX",
          "index_name": "mcp-servers-index"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
