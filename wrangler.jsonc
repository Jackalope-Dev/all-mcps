{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "all-mcps",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "allmcps.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "all-mcps",
      "database_id": "c0e237c4-fa3c-45f0-8400-b2dd44615f94",
      "migrations_dir": "drizzle"
    }
  ]
}
