{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "all-mcps",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://jackalope-digital.cloudflareaccess.com",
    "ACCESS_AUD": "1f1d6927fe441199ceac84e46059247f1dfe4caf5defb88e21d178add8fc9187",
    "ADMIN_EMAIL": "cadenjsumner@gmail.com",
    "RESEND_TO_EMAIL": "contact@allmcps.com",
    "RESEND_FROM_EMAIL": "contact@allmcps.com"
  },
  "routes": [
    { "pattern": "allmcps.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "all-mcps",
      "database_id": "c0e237c4-fa3c-45f0-8400-b2dd44615f94",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOGOS",
      "bucket_name": "all-mcps-logos"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "all-mcps-isr-cache"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "mcp-servers-index"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
